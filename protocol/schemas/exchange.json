{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven.local/exchange.json",
  "$defs": {
    "report_mapping": {"type":"object","required":["version","kpis"],"properties":{"version":{"const":"1"},"kpis":{"type":"object","properties":{"scored":{"type":"string"},"coverage":{"type":"string"},"anomalies":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false},
    "candidate": {"type":"object","required":["id","target_parameters"],"properties":{"id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},"target_parameters":{"type":"object","minProperties":1}},"additionalProperties":false},
    "comparison": {"type":"object","required":["baseline_id","case_ids","input_digest"],"properties":{"baseline_id":{"type":"string"},"case_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"input_digest":{"type":"string"}},"additionalProperties":false},
    "parameter_receipt": {"type":"object","required":["requested","state"],"properties":{"requested":{"type":"object"},"applied":{"type":"object"},"state":{"enum":["target_confirmed","mismatch","unconfirmed"]}},"additionalProperties":false},
    "source": {
      "type": "object", "required": ["id", "version", "format"],
      "properties": {
        "id": {"type":"string","minLength":1}, "version": {"type":"string","minLength":1},
        "format": {"enum":["jsonl","csv","beir","trec","seven-history"]},
        "path": {"type":"string","minLength":1}, "corpus": {"type":"string","minLength":1},
        "queries": {"type":"string","minLength":1}, "qrels": {"type":"string","minLength":1},
        "run": {"type":"string","minLength":1}, "split": {"type":"string"}, "case": {"type":"string","minLength":1}
      },
      "allOf": [
        {"if":{"properties":{"format":{"enum":["jsonl","csv","seven-history"]}}},"then":{"required":["path"]}},
        {"if":{"properties":{"format":{"const":"beir"}}},"then":{"required":["corpus","queries","qrels"]}},
        {"if":{"properties":{"format":{"const":"trec"}}},"then":{"required":["queries","qrels","run"]}}
      ],
      "additionalProperties": false
    },
    "mapping":{"type":"object","required":["id","version","fields"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"fields":{"type":"object"},"conversions":{"type":"object","additionalProperties":{"enum":["json","number","boolean","string"]}}},"additionalProperties":false},
    "turn":{"type":"object","required":["id","case"],"properties":{"id":{"type":"string","minLength":1},"case":{"$ref":"#/$defs/case"}},"additionalProperties":false},
    "episode":{"type":"object","required":["id","turns"],"properties":{"id":{"type":"string","minLength":1},"turns":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/turn"}}},"additionalProperties":false},
    "episode_result":{"type":"object","required":["id","status","case_ids","completed"],"properties":{"id":{"type":"string"},"status":{"enum":["running","completed","partial","cancelled"]},"session":{},"case_ids":{"type":"array","items":{"type":"string"}},"completed":{"type":"integer","minimum":0}},"additionalProperties":false},
    "retrieval": {"type":"object","required":["id","text"],"properties":{"id":{"type":"string","minLength":1},"text":{"type":"string"},"score":{"type":"number"}},"additionalProperties":false},
    "tool": {"type":"object","required":["id","name","status"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"status":{"enum":["completed","error","pending"]},"arguments":{"type":"object"},"result":{}},"additionalProperties":false},
    "citation": {"type":"object","required":["document_id"],"properties":{"document_id":{"type":"string"},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0}},"additionalProperties":false},
    "dataset_revision": {"type":"object","required":["source_id","source_version","files","digest"],"properties":{"source_id":{"type":"string"},"source_version":{"type":"string"},"mapping_id":{"type":"string"},"mapping_version":{"type":"string"},"files":{"type":"object","additionalProperties":{"type":"string"}},"digest":{"type":"string"}},"additionalProperties":false},
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "inputs": {},
        "references": {
          "type": "object"
        },
        "response": {},
        "contexts": {
          "type": "array",
          "items": {}
        },
        "metadata": {
          "type": "object"
        },
        "result":{"$ref":"#/$defs/subject_result"},
        "episode":{"$ref":"#/$defs/episode"}
      },
      "required": [
        "id",
        "inputs"
      ],
      "additionalProperties": false
    },
    "subject_result": {
      "type": "object",
      "properties": {
        "parameter_receipt": {"$ref":"#/$defs/parameter_receipt"},
        "response": {},
        "contexts": {
          "type": "array",
          "items": {}
        },
        "usage": {
          "type": "object"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "retrieval": {"type":"array", "items":{"$ref":"#/$defs/retrieval"}},
        "tools": {"type":"array", "items":{"$ref":"#/$defs/tool"}},
        "citations": {"type":"array", "items":{"$ref":"#/$defs/citation"}},
        "trace":{"type":"array","items":{}}
      },
      "required": [
        "response"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "response",
            "retrieval",
            "usage",
            "trace", "tool", "citation"
          ]
        },
        "value": {}
      },
      "required": [
        "id",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "metric_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "not_computable",
            "not_applicable",
            "skipped",
            "error",
            "budget_exhausted"
          ]
        },
        "value": {},
        "reason": {
          "type": "string"
        },
        "evaluator": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "metric_id",
        "case_id",
        "status",
        "value",
        "evaluator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "processor_output": {
      "type": "object",
      "properties": {
        "report":{"$ref":"#/$defs/report_mapping"},
        "processor": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "input_digest": {
          "type": "string"
        }
      },
      "required": [
        "processor",
        "data",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "conclusion": {
      "type": "object",
      "properties": {
        "handler": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "fail",
            "pass"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "handler",
        "code",
        "level",
        "summary"
      ],
      "additionalProperties": false
    },
    "descriptor": {
      "type": "object",
      "properties": {
        "execution_class": {"enum":["deterministic","judge"]},
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "subject",
            "evaluator",
            "processor",
            "conclusion"
          ]
        },
        "version": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": true
    },
    "stream": {
      "type": "object",
      "properties": {
        "unit": { "enum": ["trace", "turn"] },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "refresh_seconds": { "type": "integer", "minimum": 1 },
        "allowed_lateness_seconds": { "type": "integer", "minimum": 0 },
        "quiet_seconds": { "type": "integer", "minimum": 0 },
        "evidence_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "max_pending": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "judge_sample_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "judge_per_window_budget": { "type": "integer", "minimum": 0 }
      },
      "required": ["unit"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "target_parameters":{"type":"object"},
        "candidates":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/candidate"}},
        "schema_version": {
          "const": "evaluate.plan/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "preset": {
          "enum": ["builtin.basic@1", "builtin.rag-basic@1", "builtin.agent-basic@1"]
        },
        "mode": {
          "enum": [
          "invoke",
          "replay",
          "stream"
          ]
        },
        "dataset": {
          "type": "string"
        },
        "source": {"type":"string"},
        "mapping": {"type":"string"},
        "parameters": {"type":"object"},
        "subject": {
          "type": "string"
        },
        "evaluators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "stream": { "$ref": "#/$defs/stream" }
      },
      "required": [
        "schema_version",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "mode": { "const": "stream" } }, "required": ["mode"] },
        "then": { "required": ["stream"], "allOf": [{ "not": { "required": ["dataset"] } }, { "not": { "required": ["subject"] } }] },
        "else": { "oneOf": [{"required":["dataset"],"not":{"required":["source"]}}, {"required":["source"],"not":{"required":["dataset"]}}] }
      }]
    },
    "package": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluate.package/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "production_event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluate.event/v1"
        },
        "source": {
          "type": "string"
        },
        "project": { "type": "string" },
        "event_id": {
          "type": "string"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string"
        },
        "turn_id": { "type": "string" },
        "evidence_revision": { "type": "integer", "minimum": 1 },
        "case": {
          "$ref": "#/$defs/case"
        },
        "result": {
          "$ref": "#/$defs/subject_result"
        }
      },
      "required": [
        "schema_version",
        "source",
        "project",
        "event_id",
        "event_time",
        "trace_id",
        "case",
        "result"
      ],
      "additionalProperties": false
    },
    "effective": {
      "type": "object",
      "properties": {
        "node_runtime":{"type":"object","required":["snapshot_id","version"],"properties":{"snapshot_id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},"version":{"type":"string"}},"additionalProperties":false},
        "plan": {
          "type": "object"
        },
        "evaluators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "scope": { "$ref": "#/$defs/window_scope" },
        "dataset_revision": {"$ref":"#/$defs/dataset_revision"}
      },
      "required": [
        "plan",
        "evaluators",
        "processors",
        "conclusions",
        "assets",
        "digest"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "input_count": {"type":"integer","minimum":0,"maximum":10000},
        "result_count": {"type":"integer","minimum":0,"maximum":10000},
        "format": {
          "const": "seven.eval"
        },
        "schema_version": {
          "const": "2.0"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "scope": { "$ref": "#/$defs/window_scope" }
      },
      "required": [
        "input_count",
        "result_count",
        "format",
        "schema_version",
        "run_id",
        "status",
        "files"
      ],
      "additionalProperties": false
    },
    "window_scope": {
      "type": "object",
      "properties": {
        "statistics_available": {"type":"boolean"},
        "skipped": {"type":"integer","minimum":0},
        "budget_exhausted": {"type":"integer","minimum":0},
        "unscored": {"type":"integer","minimum":0},
        "facts": {"type":"array","items":{"type":"object"}},
        "backlog_facts": {"type":"array","items":{"type":"object"}},
        "coverage": {"type":"number","minimum":0,"maximum":1},
        "reasons": {"type":"object","additionalProperties":{"type":"integer","minimum":0}},
        "anomalies": {"type":"integer","minimum":0},
        "kind": { "const": "window" }, "plan_id": { "type": "string" }, "source": { "type": "string" },
        "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" },
        "watermark": { "type": "string", "format": "date-time" }, "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["provisional", "final"] }, "received": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 }, "sampled": { "type": "integer", "minimum": 0 },
        "scored": { "type": "integer", "minimum": 0 }, "not_computable": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }, "pending": { "type": "integer", "minimum": 0 },
        "p50_latency_ms": { "type": "number", "minimum": 0 }, "p95_latency_ms": { "type": "number", "minimum": 0 },
        "judge_sample_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "judge_per_window_budget": { "type": "integer", "minimum": 0 }
      },
      "required": ["kind", "plan_id", "start", "end", "watermark", "revision", "state", "received", "eligible", "sampled", "scored", "not_computable", "failed", "pending"],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "comparison":{"$ref":"#/$defs/comparison"},
        "schema_version": {
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "created_at": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "processing",
            "completed",
            "partial",
            "cancelled",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "$ref": "#/$defs/effective"
        },
        "dataset_digest": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_result"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processor_output"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conclusion"
          }
        },
        "catalogs": {
          "type": "object"
        },
        "episodes":{"type":"array","items":{"$ref":"#/$defs/episode_result"}},
        "scope": { "$ref": "#/$defs/window_scope" },
        "dataset_revision": {"$ref":"#/$defs/dataset_revision"}
      },
      "required": [
        "schema_version",
        "id",
        "package",
        "created_at",
        "status",
        "total",
        "completed",
        "effective",
        "dataset_digest",
        "outputs",
        "conclusions",
        "catalogs"
      ],
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case": {
          "$ref": "#/$defs/case"
        },
        "status": {
          "enum": [
            "completed",
            "error",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/subject_result"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "redaction_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "case",
        "status",
        "attempt",
        "result",
        "evidence",
        "metrics"
      ]
    }
  },
  "oneOf": [
    {"type":"object","properties":{"kind":{"const":"source"},"value":{"$ref":"#/$defs/source"}},"required":["kind","value"],"additionalProperties":false},
    {"type":"object","properties":{"kind":{"const":"mapping"},"value":{"$ref":"#/$defs/mapping"}},"required":["kind","value"],"additionalProperties":false},
    {"type":"object","properties":{"kind":{"const":"episode"},"value":{"$ref":"#/$defs/episode"}},"required":["kind","value"],"additionalProperties":false},
    {"type":"object","properties":{"kind":{"const":"turn"},"value":{"$ref":"#/$defs/turn"}},"required":["kind","value"],"additionalProperties":false},
    {"type":"object","properties":{"kind":{"const":"dataset_revision"},"value":{"$ref":"#/$defs/dataset_revision"}},"required":["kind","value"],"additionalProperties":false},
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "case"
        },
        "value": {
          "$ref": "#/$defs/case"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "subject_result"
        },
        "value": {
          "$ref": "#/$defs/subject_result"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "value": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "metric"
        },
        "value": {
          "$ref": "#/$defs/metric"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "processor_output"
        },
        "value": {
          "$ref": "#/$defs/processor_output"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "conclusion"
        },
        "value": {
          "$ref": "#/$defs/conclusion"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "descriptor"
        },
        "value": {
          "$ref": "#/$defs/descriptor"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "plan"
        },
        "value": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "package"
        },
        "value": {
          "$ref": "#/$defs/package"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "production_event"
        },
        "value": {
          "$ref": "#/$defs/production_event"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "effective"
        },
        "value": {
          "$ref": "#/$defs/effective"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "manifest"
        },
        "value": {
          "$ref": "#/$defs/manifest"
        }
      },
      "required": [
        "kind",
        "value"
      ],
