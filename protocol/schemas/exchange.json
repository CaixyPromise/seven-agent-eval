{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven.local/exchange.json",
  "$defs": {
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {},
        "references": {
          "type": "object"
        },
        "response": {},
        "contexts": {
          "type": "array",
          "items": {}
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "inputs"
      ],
      "additionalProperties": false
    },
    "subject_result": {
      "type": "object",
      "properties": {
        "response": {},
        "contexts": {
          "type": "array",
          "items": {}
        },
        "usage": {
          "type": "object"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "response"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "response",
            "retrieval",
            "usage",
            "trace"
          ]
        },
        "value": {}
      },
      "required": [
        "id",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "metric_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "not_computable",
            "not_applicable",
            "skipped",
            "error",
            "budget_exhausted"
          ]
        },
        "value": {},
        "reason": {
          "type": "string"
        },
        "evaluator": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "metric_id",
        "case_id",
        "status",
        "value",
        "evaluator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "processor_output": {
      "type": "object",
      "properties": {
        "processor": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "input_digest": {
          "type": "string"
        }
      },
      "required": [
        "processor",
        "data",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "conclusion": {
      "type": "object",
      "properties": {
        "handler": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warning",
            "fail",
            "pass"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "handler",
        "code",
        "level",
        "summary"
      ],
      "additionalProperties": false
    },
    "descriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "subject",
            "evaluator",
            "processor",
            "conclusion"
          ]
        },
        "version": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "version"
      ],
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluate.plan/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "preset": {
          "const": "builtin.basic@1"
        },
        "mode": {
          "enum": [
            "invoke",
            "replay"
          ]
        },
        "dataset": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "evaluators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "schema_version",
        "id",
        "dataset"
      ],
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluate.package/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "production_event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluate.event/v1"
        },
        "source": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string"
        },
        "case": {
          "$ref": "#/$defs/case"
        },
        "result": {
          "$ref": "#/$defs/subject_result"
        }
      },
      "required": [
        "schema_version",
        "source",
        "event_id",
        "event_time",
        "trace_id",
        "case",
        "result"
      ],
      "additionalProperties": false
    },
    "effective": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object"
        },
        "evaluators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "digest": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "plan",
        "evaluators",
        "processors",
        "conclusions",
        "assets",
        "digest"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "seven.eval"
        },
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "format",
        "schema_version",
        "run_id",
        "status",
        "files"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "created_at": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "processing",
            "completed",
            "partial",
            "cancelled",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "effective": {
          "$ref": "#/$defs/effective"
        },
        "dataset_digest": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_result"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processor_output"
          }
        },
        "conclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conclusion"
          }
        },
        "catalogs": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "id",
        "package",
        "created_at",
        "status",
        "total",
        "completed",
        "effective",
        "dataset_digest",
        "cases",
        "outputs",
        "conclusions",
        "catalogs"
      ],
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case": {
          "$ref": "#/$defs/case"
        },
        "status": {
          "enum": [
            "completed",
            "error",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/subject_result"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "redaction_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "case",
        "status",
        "attempt",
        "result",
        "evidence",
        "metrics"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "case"
        },
        "value": {
          "$ref": "#/$defs/case"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "subject_result"
        },
        "value": {
          "$ref": "#/$defs/subject_result"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "value": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "metric"
        },
        "value": {
          "$ref": "#/$defs/metric"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "processor_output"
        },
        "value": {
          "$ref": "#/$defs/processor_output"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "conclusion"
        },
        "value": {
          "$ref": "#/$defs/conclusion"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "descriptor"
        },
        "value": {
          "$ref": "#/$defs/descriptor"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "plan"
        },
        "value": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "package"
        },
        "value": {
          "$ref": "#/$defs/package"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "production_event"
        },
        "value": {
          "$ref": "#/$defs/production_event"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "effective"
        },
        "value": {
          "$ref": "#/$defs/effective"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "manifest"
        },
        "value": {
          "$ref": "#/$defs/manifest"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "run"
        },
        "value": {
          "$ref": "#/$defs/run"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "case_result"
        },
        "value": {
          "$ref": "#/$defs/case_result"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    }
  ]
}
